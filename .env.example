# ============================================================================
# linQ Web (.env) — EXAMPLE ONLY
# ============================================================================
# Copy this file to `.env` and fill in real values.
#
# Local dev: the file at `.env` is loaded by Vite. The `.env` filename is
# git-ignored (see .gitignore).
#
# Production / Lovable Cloud: set these via the Lovable dashboard
# (Settings → Environment variables) — never paste secrets here.
# ============================================================================

# --- Supabase --------------------------------------------------------------
# These two are PUBLISHABLE (safe to ship to the client bundle).
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOi...

# Server-only. NEVER expose to the client. Local dev: copy from
# Supabase dashboard → Project Settings → API → service_role key.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- DeepSeek (AI matching / meet-plan generation) -----------------------
DEEPSEEK_API_KEY=sk-...

# --- WeChat Web Login -----------------------------------------------------
# 1. Register at https://open.weixin.qq.com/  (企业资质 or 海外主体)
# 2. Create a "网站应用" (Web app) and bind the domain claudematch.com
# 3. Authorize the callback URL below on that Web app
# 4. Paste the AppID + AppSecret here
WECHAT_APP_ID=wx...
WECHAT_APP_SECRET=...
# The full absolute URL the user lands on after scanning the QR code.
# Must be registered in the WeChat Open Platform dashboard exactly.
WECHAT_REDIRECT_URI=https://claudematch.com/api/auth/wechat/callback
# The SPA origin used when redirecting back from the callback.
# Defaults to https://claudematch.com if unset.
FRONTEND_ORIGIN=https://claudematch.com
